# Copy to .env and adjust. The database is entirely optional: leave the
# NETWATCH_DB_* vars unset and Netwatch runs fine with in-memory results only.
# Set all five to try connecting at startup -- if the connection fails, it
# logs a warning and falls back to in-memory mode instead of exiting.

NETWATCH_DB_HOST=host.containers.internal
NETWATCH_DB_PORT=5432
NETWATCH_DB_USER=USERNAME
NETWATCH_DB_PASSWORD=CHANGEME
NETWATCH_DB_NAME=netwatch

# Default subnet/network to scan when none is passed on the CLI/API.
# Point this at the scan-target Podman network's subnet (see deploy/scan-network).
NETWATCH_DEFAULT_TARGET=10.89.0.0/24

# HTTP server bind address
NETWATCH_HTTP_ADDR=:8080
